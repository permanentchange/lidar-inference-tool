# ============================================================
# Demo: Ignore Everything by Default
# ============================================================
/demo/*

# Allow selected directories
!/demo/centerpoint_pillar/
!/demo/centerpoint_voxel/
!/demo/bevfusion/
!/demo/data/

# ============================================================
# Demo Models: Keep ONNX Only
# ============================================================
/demo/centerpoint_pillar/*
# !/demo/centerpoint_pillar/*.onnx

/demo/centerpoint_voxel/*
# !/demo/centerpoint_voxel/*.onnx

/demo/bevfusion/*
# !/demo/bevfusion/*.onnx

# ============================================================
# Demo Data: Keep Selected Datasets
# ============================================================
/demo/data/*
!/demo/data/lidar/
!/demo/data/bevfusion/

/demo/data/bevfusion/*
!/demo/data/bevfusion/frames/

# Allow all files recursively in selected datasets
!/demo/data/lidar/**
!/demo/data/bevfusion/frames/**